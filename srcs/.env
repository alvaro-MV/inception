# ========================
# DOMAIN
# ========================
DOMAIN_NAME=alvmoral.42.fr

# ========================
# MYSQL / MARIADB
# ========================
MYSQL_HOST=mariadb
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wp_user
MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_root_password
MYSQL_PASSWORD_FILE=/run/secrets/db_password

# ========================
# WORDPRESS
# ========================
WP_TITLE=Inception Site

WP_ADMIN_USER=alvmoral_owner
WP_ADMIN_EMAIL=owner@example.com
WP_ADMIN_PASSWORD_FILE=/run/secrets/wp_admin_password

WP_USER=alvmoral_user
WP_USER_EMAIL=user@example.com
WP_USER_PASSWORD_FILE=/run/secrets/wp_user_password

# ========================
# PATHS
# ========================
WORDPRESS_VOLUME_PATH=/home/alvmoral/data/wp
MARIADB_VOLUME_PATH=/home/alvmoral/data/db